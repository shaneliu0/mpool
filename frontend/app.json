{
  "expo": {
    "name": "MPool",
    "slug": "mpool",
    "version": "1.0.14",
    "orientation": "portrait",
    "icon": "./assets/images/icongraphic.png",
    "scheme": "myapp",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/iconsplash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.katori.mpool",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "This app uses photos to upload images to your profile."
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.katori.mpool",
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_API_KEY"
        }
      }
    },
    "web": {
      "favicon": "./assets/images/icongraphic.png"
    },
    "description": "",
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    },
    "plugins": [
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ]
  }
}