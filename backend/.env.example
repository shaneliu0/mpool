# PostgreSQL connection string. The database needs PostGIS enabled.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Server-side Google Maps Platform key.
GOOGLE_MAPS_API_KEY=""

# Must match config.server_recipient_key in the Firebase function config.
FIREBASE_FUNCTIONS_RECIPIENT=""

# Used by the backend's email code.
SENDGRID_API_KEY=""

# Optional. Only needed if enhanced push security is on for your Expo project.
EXPO_ACCESS_TOKEN=""

# Optional. Defaults to 3001.
PORT=3001

# Optional, for local development only. Any non-empty value lets every email
# domain sign in, so leave this unset in production.
# ALLOW_ALL=TRUE
