// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId      String        @id
  email       String        @unique
  displayName String
  pools       Pool[]
  requests    PoolRequest[]
  Message     Message[]
}

model Pool {
  poolId  Int       @id @default(autoincrement())
  name    String    @db.VarChar(255)
  message Message[]
  users   User[]
}

model Message {
  messageId Int      @id @default(autoincrement())
  sender    User     @relation(fields: [senderId], references: [userId])
  senderId  String
  createdAt DateTime @default(now())
  pool      Pool     @relation(fields: [poolId], references: [poolId])
  poolId    Int
  content   String   @db.VarChar(255)
}

model Place {
  placeId   Int                                  @id @default(autoincrement())
  name      String
  coords    Unsupported("geometry(Point, 3857)")
  fromPools PoolRequest[]                        @relation("from")
  toPools   PoolRequest[]                        @relation("to")
}

model PoolSeason {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(255)
  PoolRequest PoolRequest[]
}

model PoolRequest {
  requestId    Int        @id @default(autoincrement())
  season       PoolSeason @relation(fields: [poolSeasonId], references: [id])
  seasonId     Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [userId])
  userId       String
  from         Place      @relation(name: "from", fields: [fromId], references: [placeId])
  fromId       Int
  to           Place      @relation(name: "to", fields: [toId], references: [placeId])
  toId         Int
  poolSeasonId Int
}
