// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId      String        @id
  email       String        @unique
  displayName String
  pools       Pool[]
  requests    PoolRequest[]
  Message     Message[]
}

model Pool {
  poolId      Int           @id @default(autoincrement())
  name        String        @db.VarChar(255)
  message     Message[]
  users       User[]
  PoolRequest PoolRequest[]
}

model Message {
  messageId Int      @id @default(autoincrement())
  sender    User     @relation(fields: [senderId], references: [userId])
  senderId  String
  createdAt DateTime @default(now())
  pool      Pool     @relation(fields: [poolId], references: [poolId])
  poolId    Int
  content   String   @db.VarChar(255)
}

model Place {
  placeId   Int                                  @id @default(autoincrement())
  name      String
  coords    Unsupported("geometry(Point, 3857)")
  fromPools PoolRequest[]                        @relation("from")
  toPools   PoolRequest[]                        @relation("to")
}

model PoolSeason {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(255)
  endsAt      DateTime
  PoolRequest PoolRequest[]
  active      Boolean
}

model PoolRequest {
  requestId  Int        @id @default(autoincrement())
  season     PoolSeason @relation(fields: [seasonId], references: [id])
  seasonId   Int
  pool       Pool       @relation(fields: [poolId], references: [poolId])
  poolId     Int
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [userId])
  userId     String
  departTime DateTime
  from       Place      @relation(name: "from", fields: [fromId], references: [placeId])
  fromId     Int
  to         Place      @relation(name: "to", fields: [toId], references: [placeId])
  toId       Int
  active     Boolean    @default(true)
}

model Interest {
  interestId Int              @id @default(autoincrement())
  name       String
  emoji      String
  category   InterestCategory @relation(fields: [categoryId], references: [categoryId])
  categoryId Int
}

model InterestCategory {
  categoryId Int        @id @default(autoincrement())
  name       String
  interests  Interest[]
}
