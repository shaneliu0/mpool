// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId             String               @id
  email              String
  displayName        String
  photoUrl           String
  deleted            Boolean              @default(false)
  requests           PoolRequest[]
  Message            Message[]
  Notification       Notification[]
  Profile            Profile              @relation(fields: [profileId], references: [profileId])
  profileId          Int
  PotentialMatch     PotentialMatch[]
  NotificationTokens NotificationTokens[]
  UnreadMessage      UnreadMessage[]
  CheckedIn          CheckedIn[]
  sentReports        Reports[]            @relation("reportedby")
  receivedReports    Reports[]            @relation("reporteduser")
  blockedUsers       BlockedUser[]        @relation("blockedby")
  receivedBlocks     BlockedUser[]        @relation("blockeduser")
}

model CheckedIn {
  userId    String   @id
  User      User     @relation(fields: [userId], references: [userId])
  createdAt DateTime @default(now())
}

model Profile {
  profileId   Int              @id @default(autoincrement())
  userId      String
  description String
  initialized Boolean
  createdAt   DateTime         @default(now())
  content     ProfileContent[]
  User        User[]
}

model ProfileContent {
  profileContentId Int           @id @default(autoincrement())
  prompt           Prompt        @relation(fields: [promptId], references: [promptId])
  promptId         Int
  text             String?
  tiles            ContentTile[]
  Profile          Profile?      @relation(fields: [profileProfileId], references: [profileId])
  profileProfileId Int?
}

model ContentTile {
  contentTileId                  Int             @id @default(autoincrement())
  content                        String?
  interest                       Interest?       @relation(fields: [interestId], references: [interestId])
  interestId                     Int?
  ProfileContent                 ProfileContent? @relation(fields: [profileContentProfileContentId], references: [profileContentId])
  profileContentProfileContentId Int?
}

model Notification {
  notificationId Int      @id @default(autoincrement())
  recipient      User     @relation(fields: [recipientId], references: [userId])
  recipientId    String
  createdAt      DateTime @default(now())
  title          String
  body           String
  type           String
  payload        Json?
}

model NotificationTokens {
  userId        String   @id
  User          User     @relation(fields: [userId], references: [userId])
  expoPushToken String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  disabled      Boolean  @default(false)
}

model Pool {
  poolId           Int              @id @default(autoincrement())
  season           PoolSeason       @relation(fields: [seasonId], references: [id])
  seasonId         Int
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  departTime       DateTime?
  from             Place?           @relation(name: "from", fields: [fromId], references: [placeId])
  fromId           String?
  to               Place?           @relation(name: "to", fields: [toId], references: [placeId])
  toId             String?
  disabled         Boolean          @default(false)
  message          Message[]
  PoolRequest      PoolRequest[] // these pool request users have accepted and are in the pool
  PotentialMatch   PotentialMatch[] @relation("matched") // these are matches that have been made directly to the pool
  DerivedFromMatch PotentialMatch[] @relation("derived") // these the match which the pool has been created from.
  UnreadMessage    UnreadMessage[]
}

model PotentialMatch {
  potentialMatchId Int      @id @default(autoincrement())
  seasonId         Int
  pool             Pool?    @relation(name: "matched", fields: [poolId], references: [poolId])
  poolId           Int?
  users            User[]
  declined         Boolean  @default(false)
  derivedPool      Pool?    @relation(name: "derived", fields: [derivedPoolId], references: [poolId])
  derivedPoolId    Int?
  createdAt        DateTime @default(now())
}

model Message {
  messageId Int       @id @default(autoincrement())
  sender    User      @relation(fields: [senderId], references: [userId])
  senderId  String
  createdAt DateTime  @default(now())
  pool      Pool      @relation(fields: [poolId], references: [poolId])
  poolId    Int
  content   String    @db.VarChar(1500)
  Reports   Reports[]
}

model Reports {
  reportId    Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  createdBy   User     @relation(name: "reportedby", fields: [createdById], references: [userId])
  createdById String
  reason      String
  message     Message? @relation(fields: [messageId], references: [messageId])
  messageId   Int?
  user        User?    @relation(name: "reporteduser", fields: [userId], references: [userId])
  userId      String?
}

model BlockedUser {
  blockId     Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  blockedBy   User     @relation(name: "blockedby", fields: [blockedById], references: [userId])
  blockedById String
  user        User     @relation(name: "blockeduser", fields: [userId], references: [userId])
  userId      String
}

model UnreadMessage {
  userId    String
  poolId    Int
  User      User     @relation(fields: [userId], references: [userId])
  Pool      Pool     @relation(fields: [poolId], references: [poolId])
  createdAt DateTime @default(now())

  @@unique([userId, poolId])
}

model Place {
  placeId          String                               @id
  name             String
  coords           Unsupported("geometry(Point, 3857)")
  fromPoolRequests PoolRequest[]                        @relation("from")
  toPoolRequests   PoolRequest[]                        @relation("to")
  createdAt        DateTime                             @default(now())
  updatedAt        DateTime                             @updatedAt
  University       University?                          @relation(fields: [universityId], references: [universityId])
  universityId     Int?
  category         String?
  fromPools        Pool[]                               @relation("from")
  toPools          Pool[]                               @relation("to")
}

model PoolSeason {
  id                 Int           @id @default(autoincrement())
  name               String        @db.VarChar(255)
  endsAt             DateTime
  enforceFromAirport Boolean       @default(false)
  enforceToAirport   Boolean       @default(false)
  defaultTime        DateTime      @default(now())
  PoolRequest        PoolRequest[]
  active             Boolean
  university         University    @relation(fields: [universityId], references: [universityId])
  universityId       Int
  Pool               Pool[]
}

model PoolRequest {
  requestId   Int        @id @default(autoincrement())
  season      PoolSeason @relation(fields: [seasonId], references: [id])
  seasonId    Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [userId])
  userId      String
  departTime  DateTime
  from        Place      @relation(name: "from", fields: [fromId], references: [placeId])
  fromId      String
  to          Place      @relation(name: "to", fields: [toId], references: [placeId])
  toId        String
  active      Boolean    @default(true)
  Pool        Pool?      @relation(fields: [poolId], references: [poolId])
  poolId      Int?
  description String?
}

model Prompt {
  promptId         Int              @id @default(autoincrement())
  name             String
  allowText        Boolean          @default(true)
  allowTiles       Boolean          @default(true)
  restrictTiles    Boolean          @default(false)
  allowedInterests Interest[]
  ProfileContent   ProfileContent[]
}

model Interest {
  interestId  Int              @id @default(autoincrement())
  name        String
  emoji       String
  category    InterestCategory @relation(fields: [categoryId], references: [categoryId])
  categoryId  Int
  Prompt      Prompt?          @relation(fields: [promptId], references: [promptId])
  promptId    Int?
  ContentTile ContentTile[]
}

model InterestCategory {
  categoryId Int        @id @default(autoincrement())
  name       String
  interests  Interest[]
}

model University {
  universityId          Int          @id
  name                  String
  emailDomain           String
  colorsObject          Json         @default("{}")
  shortTimeZoneName     String       @default("EST")
  timeZoneOffsetFromEST Int          @default(0)
  PoolSeason            PoolSeason[]
  defaultPlaces         Place[]
}
