// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId       String         @id
  email        String         @unique
  displayName  String
  photoUrl     String
  pools        Pool[]
  requests     PoolRequest[]
  Message      Message[]
  Notification Notification[]
  Profile      Profile        @relation(fields: [profileId], references: [profileId])
  profileId    Int
}

model Profile {
  profileId   Int              @id @default(autoincrement())
  userId      String
  description String
  initialized Boolean
  createdAt   DateTime         @default(now())
  content     ProfileContent[]
  User        User[]
}

model ProfileContent {
  profileContentId Int           @id @default(autoincrement())
  prompt           Prompt        @relation(fields: [promptId], references: [promptId])
  promptId         Int
  text             String?
  tiles            ContentTile[]
  Profile          Profile?      @relation(fields: [profileProfileId], references: [profileId])
  profileProfileId Int?
}

model ContentTile {
  contentTileId                  Int             @id @default(autoincrement())
  content                        String?
  interest                       Interest?       @relation(fields: [interestId], references: [interestId])
  interestId                     Int?
  ProfileContent                 ProfileContent? @relation(fields: [profileContentProfileContentId], references: [profileContentId])
  profileContentProfileContentId Int?
}

model Notification {
  notificationId Int      @id @default(autoincrement())
  recipient      User     @relation(fields: [recipientId], references: [userId])
  recipientId    String
  createdAt      DateTime @default(now())
  title          String
  body           String
  type           String
  payload        Json?
}

model Pool {
  poolId      Int           @id @default(autoincrement())
  name        String        @db.VarChar(255)
  season      PoolSeason    @relation(fields: [seasonId], references: [id])
  seasonId    Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  departTime  DateTime?
  from        Place?         @relation(name: "from", fields: [fromId], references: [placeId])
  fromId      String?
  to          Place?         @relation(name: "to", fields: [toId], references: [placeId])
  toId        String?
  message     Message[]
  users       User[]
  PoolRequest PoolRequest[]
}

model Message {
  messageId Int      @id @default(autoincrement())
  sender    User     @relation(fields: [senderId], references: [userId])
  senderId  String
  createdAt DateTime @default(now())
  pool      Pool     @relation(fields: [poolId], references: [poolId])
  poolId    Int
  content   String   @db.VarChar(255)
}

model Place {
  placeId          String                               @id
  name             String
  coords           Unsupported("geometry(Point, 3857)")
  fromPoolRequests PoolRequest[]                        @relation("from")
  toPoolRequests   PoolRequest[]                        @relation("to")
  createdAt        DateTime                             @default(now())
  updatedAt        DateTime                             @updatedAt
  University       University?                          @relation(fields: [universityId], references: [universityId])
  universityId     Int?
  category         String?
  fromPools        Pool[]                               @relation("from")
  toPools          Pool[]                               @relation("to")
}

model PoolSeason {
  id           Int           @id @default(autoincrement())
  name         String        @db.VarChar(255)
  endsAt       DateTime
  PoolRequest  PoolRequest[]
  active       Boolean
  university   University    @relation(fields: [universityId], references: [universityId])
  universityId Int
  Pool         Pool[]
}

model PoolRequest {
  requestId  Int        @id @default(autoincrement())
  season     PoolSeason @relation(fields: [seasonId], references: [id])
  seasonId   Int
  pool       Pool?      @relation(fields: [poolId], references: [poolId])
  poolId     Int?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [userId])
  userId     String
  departTime DateTime
  from       Place      @relation(name: "from", fields: [fromId], references: [placeId])
  fromId     String
  to         Place      @relation(name: "to", fields: [toId], references: [placeId])
  toId       String
  active     Boolean    @default(true)
}

model Prompt {
  promptId         Int              @id @default(autoincrement())
  name             String
  allowText        Boolean          @default(true)
  allowTiles       Boolean          @default(true)
  restrictTiles    Boolean          @default(false)
  allowedInterests Interest[]
  ProfileContent   ProfileContent[]
}

model Interest {
  interestId  Int              @id @default(autoincrement())
  name        String
  emoji       String
  category    InterestCategory @relation(fields: [categoryId], references: [categoryId])
  categoryId  Int
  Prompt      Prompt?          @relation(fields: [promptId], references: [promptId])
  promptId    Int?
  ContentTile ContentTile[]
}

model InterestCategory {
  categoryId Int        @id @default(autoincrement())
  name       String
  interests  Interest[]
}

model University {
  universityId  Int          @id
  name          String
  emailDomain   String
  PoolSeason    PoolSeason[]
  defaultPlaces Place[]
}
